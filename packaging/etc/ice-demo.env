# ice-demo environment variables — edit as needed, then:
#   sudo systemctl restart ice-demo

# TCP port the Next.js server binds to. Renamed from the generic PORT so it
# doesn't collide with $PORT that other apps on the same machine also read;
# the systemd unit maps this back to PORT for Node at exec time.
ICE_DEMO_PORT=4123

# Bind address. 0.0.0.0 = all interfaces; 127.0.0.1 = localhost only.
HOSTNAME=0.0.0.0

# Node environment. Leave as 'production' unless debugging.
NODE_ENV=production
